{
  "manifest_version": 3,
  "name": "Meetling Sofortkonferenz",
  "version": "2.0.8",
  "description": "Starte mit einem Klick eine Meetling Videokonferenz.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "app_meetling_de_chrome_plugin.png",
      "48": "app_meetling_de_chrome_plugin.png",
      "128": "app_meetling_de_chrome_plugin.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "notifications",
    "windows"
  ],
  "host_permissions": [
    "https://*/"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "icons": {
    "16": "app_meetling_de_chrome_plugin.png",
    "48": "app_meetling_de_chrome_plugin.png",
    "128": "app_meetling_de_chrome_plugin.png"
  }
}
